@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="layout">
    <NavMenu />

    <div class="main-wrapper">

        <div class="top-bar">
            <div class="top-bar-content">
                <div class="top-bar-left">
                    <span class="top-bar-title">Mini GMAO</span>
                    <span class="top-bar-sep">|</span>
                    <span class="top-bar-sub">Gestion de Maintenance</span>
                </div>

                <div class="top-bar-right">
                    <AuthorizeView>
                        <Authorized>
                            <div class="user-chip">
                                <div class="user-avatar-sm">
                                    @(context.User.Identity?.Name?.Split('@')[0].ToUpper().FirstOrDefault())
                                </div>
                                <div class="user-details">
                                    <span class="user-name">@context.User.Identity?.Name</span>
                                    @if (context.User.IsInRole("Admin"))
                                    {
                                        <span class="role-badge">Admin</span>
                                    }
                                </div>
                            </div>
                            <form method="post" action="/api/auth/logout" data-enhance="false">
                                <button type="submit" class="logout-btn">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                        <polyline points="16 17 21 12 16 7"/>
                                        <line x1="21" y1="12" x2="9" y2="12"/>
                                    </svg>
                                    Déconnexion
                                </button>
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login" class="logout-btn">Se connecter</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        <div class="main-content">
            @Body
        </div>

    </div>
</div>

<div id="blazor-error-ui">
    Une erreur est survenue. <a href="" class="reload">Recharger</a>
    <a class="dismiss">🗙</a>
</div>
